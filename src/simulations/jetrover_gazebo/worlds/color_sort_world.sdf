<?xml version="1.0" ?>
<!--
  Closed-loop IK colour-sorting world for the JetRover arm.

  Seen from above, robot at the origin. The arm's workspace is along -Y:

      +....&gt; x            [red] [green] [blue] [yellow]   pick row,   y = -0.22
      .                   [ ] [ ] [ ] [ ]                 place row,  y = -0.32
      v -y

  All four blocks and all four bins are inside the position-only IK reachable
  zone. The blocks are 3 cm cubes and are NOT static, so a pick (or a mouse
  drag in the GUI) actually moves them. The bins are static, shallow open boxes
  used as place targets.

  Lighting is deliberately brighter and less directional than
  jetrover_world.sdf: LAB thresholding degrades badly under hard shadows,
  so an extra fill light keeps the block faces evenly lit.

  The world name is deliberately "color_blocks_world" so the existing
  /world/color_blocks_world/... bridge and attacher plumbing is reused.
-->
<sdf version="1.9">
  <world name="color_blocks_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libjetrover-grasp-velocity-system.so" name="jetrover::gazebo::systems::GraspVelocitySystem">
      <topic>/grasp/entity_command</topic>
      <command_timeout>0.2</command_timeout>
    </plugin>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.75 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.1 -0.95</direction>
    </light>

    <!-- Fill light from the opposite side: kills the hard shadow that would
         otherwise push a block's LAB values outside its threshold range. -->
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.6 -0.3 -0.7</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <!-- Neutral mid-grey: maximises LAB separation from every block
               colour, so the floor never leaks into a colour mask. -->
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= pick blocks (3 cm cubes, dynamic) ================= -->

    <model name="block_red">
      <pose>-0.135 -0.22 0.065 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>7.5e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>7.5e-6</iyy><iyz>0</iyz>
            <izz>7.5e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material>
            <ambient>0.75 0.05 0.05 1</ambient>
            <diffuse>0.85 0.06 0.06 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
        <topic>/model/block_red/cmd_vel</topic>
      </plugin>
    </model>

    <model name="block_green">
      <pose>-0.055 -0.22 0.065 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>7.5e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>7.5e-6</iyy><iyz>0</iyz>
            <izz>7.5e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.10 1</ambient>
            <diffuse>0.06 0.75 0.12 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
        <topic>/model/block_green/cmd_vel</topic>
      </plugin>
    </model>

    <!-- Block shelf: raise the four cubes ~3 cm so the gripper's descent grabs
         the cube rather than closing above a floor cube. One low static shelf
         under all four blocks (they sit at x -0.135..0.105, y -0.22). 5 cm
         tall (top at 0.05) so each 3 cm cube (centred z=0.065, bottom 0.05)
         rests on it. Neutral grey so it doesn't move or trip the detector.
         TUNE the shelf height + cube z together if the grip still sits high
         or low after a live test. -->
    <model name="block_shelf">
      <static>true</static>
      <pose>-0.015 -0.22 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.30 0.07 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.30 0.07 0.05</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_blue">
      <pose>0.025 -0.22 0.065 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>7.5e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>7.5e-6</iyy><iyz>0</iyz>
            <izz>7.5e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.75 1</ambient>
            <diffuse>0.06 0.12 0.85 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
        <topic>/model/block_blue/cmd_vel</topic>
      </plugin>
    </model>

    <model name="block_yellow">
      <pose>0.105 -0.22 0.065 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>7.5e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>7.5e-6</iyy><iyz>0</iyz>
            <izz>7.5e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material>
            <ambient>0.80 0.70 0.05 1</ambient>
            <diffuse>0.90 0.80 0.06 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
        <topic>/model/block_yellow/cmd_vel</topic>
      </plugin>
    </model>

    <!-- ============ sorting bins (static place targets, shallow open boxes) -->

    <model name="bin_red">
      <static>true</static>
      <pose>-0.135 -0.32 0.002 0 0 0</pose>
      <link name="link">
        <!-- 9 cm square floor, 4 mm thick, centred at the bin pose -->
        <collision name="floor_collision">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
          <material>
            <ambient>0.75 0.05 0.05 1</ambient>
            <diffuse>0.85 0.06 0.06 1</diffuse>
          </material>
        </visual>
        <!-- Four 4 cm-high, 4 mm-thick walls; inner opening is 8.2 cm square -->
        <collision name="wall_front_collision">
          <pose>0 -0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
        </collision>
        <visual name="wall_front_visual">
          <pose>0 -0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
          <material>
            <ambient>0.75 0.05 0.05 1</ambient>
            <diffuse>0.85 0.06 0.06 1</diffuse>
          </material>
        </visual>
        <collision name="wall_back_collision">
          <pose>0 0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
        </collision>
        <visual name="wall_back_visual">
          <pose>0 0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
          <material>
            <ambient>0.75 0.05 0.05 1</ambient>
            <diffuse>0.85 0.06 0.06 1</diffuse>
          </material>
        </visual>
        <collision name="wall_left_collision">
          <pose>-0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
        </collision>
        <visual name="wall_left_visual">
          <pose>-0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
          <material>
            <ambient>0.75 0.05 0.05 1</ambient>
            <diffuse>0.85 0.06 0.06 1</diffuse>
          </material>
        </visual>
        <collision name="wall_right_collision">
          <pose>0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
        </collision>
        <visual name="wall_right_visual">
          <pose>0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
          <material>
            <ambient>0.75 0.05 0.05 1</ambient>
            <diffuse>0.85 0.06 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bin_green">
      <static>true</static>
      <pose>-0.055 -0.32 0.002 0 0 0</pose>
      <link name="link">
        <!-- 9 cm square floor, 4 mm thick, centred at the bin pose -->
        <collision name="floor_collision">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.10 1</ambient>
            <diffuse>0.06 0.75 0.12 1</diffuse>
          </material>
        </visual>
        <!-- Four 4 cm-high, 4 mm-thick walls; inner opening is 8.2 cm square -->
        <collision name="wall_front_collision">
          <pose>0 -0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
        </collision>
        <visual name="wall_front_visual">
          <pose>0 -0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.10 1</ambient>
            <diffuse>0.06 0.75 0.12 1</diffuse>
          </material>
        </visual>
        <collision name="wall_back_collision">
          <pose>0 0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
        </collision>
        <visual name="wall_back_visual">
          <pose>0 0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.10 1</ambient>
            <diffuse>0.06 0.75 0.12 1</diffuse>
          </material>
        </visual>
        <collision name="wall_left_collision">
          <pose>-0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
        </collision>
        <visual name="wall_left_visual">
          <pose>-0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.10 1</ambient>
            <diffuse>0.06 0.75 0.12 1</diffuse>
          </material>
        </visual>
        <collision name="wall_right_collision">
          <pose>0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
        </collision>
        <visual name="wall_right_visual">
          <pose>0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.10 1</ambient>
            <diffuse>0.06 0.75 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bin_blue">
      <static>true</static>
      <pose>0.025 -0.32 0.002 0 0 0</pose>
      <link name="link">
        <!-- 9 cm square floor, 4 mm thick, centred at the bin pose -->
        <collision name="floor_collision">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.75 1</ambient>
            <diffuse>0.06 0.12 0.85 1</diffuse>
          </material>
        </visual>
        <!-- Four 4 cm-high, 4 mm-thick walls; inner opening is 8.2 cm square -->
        <collision name="wall_front_collision">
          <pose>0 -0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
        </collision>
        <visual name="wall_front_visual">
          <pose>0 -0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.75 1</ambient>
            <diffuse>0.06 0.12 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="wall_back_collision">
          <pose>0 0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
        </collision>
        <visual name="wall_back_visual">
          <pose>0 0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.75 1</ambient>
            <diffuse>0.06 0.12 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="wall_left_collision">
          <pose>-0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
        </collision>
        <visual name="wall_left_visual">
          <pose>-0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.75 1</ambient>
            <diffuse>0.06 0.12 0.85 1</diffuse>
          </material>
        </visual>
        <collision name="wall_right_collision">
          <pose>0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
        </collision>
        <visual name="wall_right_visual">
          <pose>0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.75 1</ambient>
            <diffuse>0.06 0.12 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bin_yellow">
      <static>true</static>
      <pose>0.105 -0.32 0.002 0 0 0</pose>
      <link name="link">
        <!-- 9 cm square floor, 4 mm thick, centred at the bin pose -->
        <collision name="floor_collision">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
          <material>
            <ambient>0.80 0.70 0.05 1</ambient>
            <diffuse>0.90 0.80 0.06 1</diffuse>
          </material>
        </visual>
        <!-- Four 4 cm-high, 4 mm-thick walls; inner opening is 8.2 cm square -->
        <collision name="wall_front_collision">
          <pose>0 -0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
        </collision>
        <visual name="wall_front_visual">
          <pose>0 -0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
          <material>
            <ambient>0.80 0.70 0.05 1</ambient>
            <diffuse>0.90 0.80 0.06 1</diffuse>
          </material>
        </visual>
        <collision name="wall_back_collision">
          <pose>0 0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
        </collision>
        <visual name="wall_back_visual">
          <pose>0 0.043 0.022 0 0 0</pose>
          <geometry><box><size>0.09 0.004 0.04</size></box></geometry>
          <material>
            <ambient>0.80 0.70 0.05 1</ambient>
            <diffuse>0.90 0.80 0.06 1</diffuse>
          </material>
        </visual>
        <collision name="wall_left_collision">
          <pose>-0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
        </collision>
        <visual name="wall_left_visual">
          <pose>-0.043 0 0.022 0 0 0</pose>
          <geometry><box><size>0.004 0.082 0.04</size></box></geometry>
