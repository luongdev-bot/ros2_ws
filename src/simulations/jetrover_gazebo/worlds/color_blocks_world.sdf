<?xml version="1.0" ?>
<!--
  Colour-sorting world for the JetRover arm.

  Seen from above, robot at the origin. The arm's pick_init pose swings the
  base 90 deg, so the workspace is along -Y, not +X:

      +....&gt; x            [red] [green] [blue] [yellow]   blocks,  y = -0.245
      .                   [ ] [ ] [ ] [ ]                 bins,    y = -0.46
      v -y

  block_blue sits exactly on the point pick.d6a grasps at (0.025, -0.245),
  and all four are inside the camera view at the default pose.

  The blocks are 4 cm cubes - the size the JetRover gripper is built for -
  and are NOT static, so a pick actually moves them. The bins are static,
  flat plates used as place targets later on.

  Lighting is deliberately brighter and less directional than
  jetrover_world.sdf: LAB thresholding degrades badly under hard shadows,
  so an extra fill light keeps the block faces evenly lit.
-->
<sdf version="1.9">
  <world name="color_blocks_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.75 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.1 -0.95</direction>
    </light>

    <!-- Fill light from the opposite side: kills the hard shadow that would
         otherwise push a block's LAB values outside its threshold range. -->
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.6 -0.3 -0.7</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <!-- Neutral mid-grey: maximises LAB separation from every block
               colour, so the floor never leaks into a colour mask. -->
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= pick blocks (4 cm cubes, dynamic) ================= -->

    <model name="block_red">
      <pose>-0.135 -0.245 0.02 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.333e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.333e-5</iyy><iyz>0</iyz>
            <izz>1.333e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.75 0.05 0.05 1</ambient>
            <diffuse>0.85 0.06 0.06 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_green">
      <pose>-0.055 -0.245 0.02 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.333e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.333e-5</iyy><iyz>0</iyz>
            <izz>1.333e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.10 1</ambient>
            <diffuse>0.06 0.75 0.12 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_blue">
      <pose>0.025 -0.245 0.02 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.333e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.333e-5</iyy><iyz>0</iyz>
            <izz>1.333e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.75 1</ambient>
            <diffuse>0.06 0.12 0.85 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="block_yellow">
      <pose>0.105 -0.245 0.02 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.333e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1.333e-5</iyy><iyz>0</iyz>
            <izz>1.333e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.80 0.70 0.05 1</ambient>
            <diffuse>0.90 0.80 0.06 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ sorting bins (static place targets, 8 cm plates) ======= -->

    <model name="bin_red">
      <static>true</static>
      <pose>-0.135 -0.46 0.002 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
          <material>
            <ambient>0.75 0.05 0.05 1</ambient>
            <diffuse>0.85 0.06 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bin_green">
      <static>true</static>
      <pose>-0.055 -0.46 0.002 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.10 1</ambient>
            <diffuse>0.06 0.75 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bin_blue">
      <static>true</static>
      <pose>0.025 -0.46 0.002 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
          <material>
            <ambient>0.05 0.10 0.75 1</ambient>
            <diffuse>0.06 0.12 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="bin_yellow">
      <static>true</static>
      <pose>0.105 -0.46 0.002 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.09 0.09 0.004</size></box></geometry>
          <material>
            <ambient>0.80 0.70 0.05 1</ambient>
            <diffuse>0.90 0.80 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
