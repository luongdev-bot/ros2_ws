<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jetrover_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo Sim (Ignition Fortress) physics simulation bringup for JetRover</description>
  <maintainer email="luuluong2000hh@gmail.com">luong</maintainer>
  <license>Apache-2.0</license>

  <depend>jetrover_description</depend>
  <depend>jetrover_moveit_config</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>robot_state_publisher</depend>
  <depend>xacro</depend>
  <depend>controller_manager</depend>
  <depend>gz_ros2_control</depend>
  <depend>moveit_ros_move_group</depend>
  <depend>moveit_configs_utils</depend>
  <depend>rviz2</depend>

  <!-- sim_launcher_gui: tkinter for the window, yaml for world_catalog.yaml,
       nav2_map_server for the map_saver_cli it shells out to when saving. -->
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>

  <!-- The GUI opens terminals running these packages' launch files. They are
       exec-only: nothing here links or imports them, but without them the
       window comes up and every terminal it spawns dies with "package not
       found". -->
  <exec_depend>slam</exec_depend>
  <exec_depend>navigation</exec_depend>
  <exec_depend>peripherals</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
