    <mxCell id="mean" value="&lt;b&gt;Ý nghĩa:&lt;/b&gt; Vòng lặp này chạy vài chục lần mỗi giây, nên vật cản xuất hiện đột ngột — người đi ngang, thùng hàng để tạm — vẫn được xử lý kịp mà không cần dừng nhiệm vụ." style="rounded=1;arcSize=8;fillColor=#EEF6FF;strokeColor=#9EC1E8;html=1;fontSize=12;fontColor=#173B63;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70" y="736" width="1010" height="72" as="geometry"/></mxCell>
